{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kgj.design/schemas/quality-ledger.schema.json",
  "title": "KGJ runner-derived three-round quality ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "rubricVersion", "artifact", "artifactType", "releaseTarget", "rounds", "coreFlows"],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "rubricVersion": { "const": "kgj-quality-1.0" },
    "artifact": { "type": "string", "minLength": 1, "maxLength": 160 },
    "artifactType": { "enum": ["codex-plugin", "web-experience", "html-report", "markdown-artifact"] },
    "releaseTarget": { "type": "string", "minLength": 3, "maxLength": 200 },
    "rounds": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["round", "lens", "weight", "checks", "findings"],
        "properties": {
          "round": { "enum": [1, 2, 3] },
          "lens": { "type": "string", "minLength": 3, "maxLength": 120 },
          "weight": { "type": "number" },
          "checks": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "evidenceRef"],
              "properties": {
                "id": { "type": "string", "pattern": "^r[123]\\.[a-z0-9][a-z0-9-]{2,79}$" },
                "evidenceRef": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,119}$" }
              }
            }
          },
          "findings": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "severity", "status", "summary"],
              "properties": {
                "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,119}$" },
                "severity": { "enum": ["P0", "P1", "P2", "P3"] },
                "status": { "enum": ["open", "fixed", "closed", "deferred", "superseded"] },
                "summary": { "type": "string", "minLength": 3, "maxLength": 500 },
                "fix": { "type": "string", "maxLength": 1000 },
                "owner": { "type": "string", "maxLength": 120 },
                "evidenceRef": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,119}$" },
                "supersededBy": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,119}$" }
              },
              "allOf": [
                { "if": { "properties": { "status": { "enum": ["fixed", "closed", "superseded"] } } }, "then": { "required": ["evidenceRef"] } },
                { "if": { "properties": { "status": { "const": "deferred" } } }, "then": { "required": ["owner"] } }
              ]
            }
          }
        }
      }
    },
    "coreFlows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "evidenceRef"],
        "properties": {
          "name": { "type": "string", "minLength": 3, "maxLength": 180 },
          "evidenceRef": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,119}$" }
        }
      }
    }
  }
}
