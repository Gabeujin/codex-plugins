{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kgj.design/schemas/project-contract.schema.json",
  "title": "KGJ Design project contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "state", "paths", "surfaces", "themes", "locales", "unresolved"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "domain", "owner"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 80 },
        "domain": { "type": "string", "minLength": 2, "maxLength": 120 },
        "owner": { "type": "string", "minLength": 2, "maxLength": 80 }
      }
    },
    "state": { "enum": ["draft", "ready", "hold"] },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dna", "tokenOutput", "evidenceRegistry", "evidenceRoot"],
      "properties": {
        "dna": { "$ref": "#/$defs/portablePath" },
        "tokenOutput": { "$ref": "#/$defs/portablePath" },
        "evidenceRegistry": { "$ref": "#/$defs/portablePath" },
        "evidenceRoot": { "$ref": "#/$defs/portablePath" }
      }
    },
    "surfaces": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,39}$" } },
    "themes": { "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,39}$" } },
    "locales": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$" } },
    "unresolved": { "type": "array", "maxItems": 40, "items": { "type": "string", "minLength": 3, "maxLength": 240 } }
  },
  "$defs": {
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    }
  }
}
