    "contentLocale": ["Long Korean prose preserves semantic grouping, citation adjacency, and readable line length."],
    "dataTruth": ["Every material conclusion exposes scope, proof level, limitation, and source state."],
    "permissionsPrivacy": ["Private research notes stay local unless an allowlisted export is explicitly consented."],
    "recovery": ["Rejected or superseded evidence remains traceable and can restore the prior decision boundary."]
