{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "ontologyId": "kgj-design-ontology",
  "version": "1.2.0",
  "promise": "portable-learning-not-portable-identity",
  "entities": [
    "user",
    "product",
    "domain",
    "surface",
    "trait",
    "pattern",
    "decision",
    "evidence",
    "mutation",
    "verification",
    "project-contract",
    "evidence-record",
    "lineage-lock",
    "migration-plan",
    "pattern-candidate",
    "expert-lens",
    "review-round",
    "finding",
    "dissent",
    "insight",
    "acceptance-test"
  ],
  "traitAxes": [
    "density",
    "hierarchy",
    "typography",
    "color",
    "shape",
    "depth",
    "motion",
    "imagery",
    "voice",
    "data",
    "interaction",
    "spatial-composition"
  ],
  "contexts": [
    "product",
    "domain",
    "surface",
    "audience-expertise",
    "task",
    "risk",
    "frequency",
    "device",
    "input",
    "locale",
    "theme",
    "content-length",
    "connectivity"
  ],
  "entryTypes": [
    "observation",
    "preference",
    "rule",
    "rejection",
    "experiment",
    "outcome",
    "candidate-pattern"
  ],
  "evidenceRoles": [
    "user-stated",
    "product-observation",
    "official-source",
    "inferred",
    "tested-locally",
    "import"
  ],
  "relations": [
    "prefers",
    "rejects",
    "expresses",
    "inherits",
    "applicable-to",
    "supported-by",
    "contradicts",
    "validates",
    "challenges",
    "supersedes",
    "revokes",
    "derived-from",
    "adopts",
    "migrates-to",
    "proven-by",
    "expires",
    "reviews",
    "rebuts",
    "agrees-with",
    "requires-fix",
    "verified-by"
  ],
  "authorityOrder": [
    "rule",
    "rejection",
    "outcome",
    "preference",
    "candidate-pattern",
    "inference"
  ],
  "resolutionRules": {
    "specificityBeatsGenerality": true,
    "conflictsRemainVisible": true,
    "recencyCannotEraseHistory": true,
    "explicitRevisionRequiredToSupersede": true,
    "candidateCannotBecomeRuleAutomatically": true,
    "pendingImportCannotInfluenceResolution": true,
    "pendingInferenceCannotInfluenceResolution": true,
    "inferenceReviewRequiresIndependentEvidence": true,
    "overdueOrExpiredKnowledgeIsReviewOnly": true,
    "semanticContractOverridesRequireMigration": true
  },
  "portablePrinciples": [
    "preserve-semantic-state",
    "surface-evidence-boundary",
    "use-progressive-disclosure",
    "adapt-density-to-task",
    "keep-recovery-visible",
    "separate-identity-from-learning",
    "prefer-product-local-pattern"
  ],
  "privacy": {
    "defaultSharingClass": "private",
    "forbiddenInferenceClasses": [
      "protected-characteristic",
      "health-or-diagnosis",
      "psychological-label",
      "credential-or-secret",
      "precise-location",
      "identity-profile"
    ],
    "rawArtifactStorage": false,
    "crossUserPooling": false,
    "explicitExportConsent": true
  }
}
